# Copy the values below into Render → jeff-backend → Environment (never commit a real .env file)

# Long random string — generate one and paste it here, don't leave the default.
SECRET_KEY=change-me-to-a-long-random-string

# Postgres connection string so data survives restarts (SQLite on Render's free tier resets on every deploy).
# Use your Supabase project's connection string (Project Settings → Database → Connection string → URI),
# or a Render-managed Postgres instance. SQLAlchemy needs the "postgresql://" scheme (not "postgres://").
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Who is auto-approved and allowed to approve/reject every other company that signs up.
PLATFORM_OWNER_EMAIL=jonibekatoyev22@gmail.com

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=https://jeffworld.dev,https://frabjous-kheer-3528af.netlify.app,http://localhost:5173
